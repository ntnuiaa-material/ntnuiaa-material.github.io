{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lager-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "observability": { "enabled": true },

  // Database med ting, utlån og hendelser
  "d1_databases": [
    { "binding": "DB", "database_name": "lager", "database_id": "9b3e8333-fb62-4e7d-9d0a-bd9345875dbf" }
  ],

  // Bilder av tingene, krympet til 800 px i nettleseren før opplasting
  "kv_namespaces": [
    { "binding": "BILDER", "id": "8c98ed2bdf2a4caca707abcbaabbd3ad" }
  ],

  // Anonymiserer navn og telefon på gamle utlån, kl. 03 den 1. hver måned
  "triggers": { "crons": ["0 3 1 * *"] },

  "vars": {
    "TILLATTE_ADRESSER": "https://ntnuiaa-material.github.io,http://localhost:8787"
  }
}
