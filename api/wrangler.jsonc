{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lager-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "observability": { "enabled": true },

  // Database med ting, utlån og hendelser
  "d1_databases": [
    { "binding": "DB", "database_name": "lager", "database_id": "9b3e8333-fb62-4e7d-9d0a-bd9345875dbf" }
  ],

  // Bilder av tingene, krympet til 800 px i nettleseren før opplasting
  "kv_namespaces": [
    { "binding": "BILDER", "id": "8c98ed2bdf2a4caca707abcbaabbd3ad" }
  ],

  // Anonymiserer gamle utlån (12 mnd) og shop-bestillinger (6 mnd), kl. 03 den 1. hver måned
  "triggers": { "crons": ["0 3 1 * *"] },

  // E-post fra shopen via SMTP fra den ekte postkassa hos Domeneshop (src/smtp.js).
  // Passordet er secret, ikke vars:
  //   wrangler secret put SMTP_BRUKER    (material@ntnui-alesund.no)
  //   wrangler secret put SMTP_PASSORD
  // Tidligere Resend (RESEND_API_KEY, avsender material-shop@ntnui-alesund.no) kan komme tilbake
  // når vi har kontroll over DNS for ntnui-alesund.no. Resend sender bare til kontoeieren uten verifisert domene.
  "vars": {
    "TILLATTE_ADRESSER": "https://ntnuiaa-material.github.io,http://localhost:8787",
    "SMTP_HOST": "smtp.domeneshop.no",
    "SMTP_PORT": "465",
    "EPOST_FRA_ADRESSE": "material@ntnui-alesund.no",
    "EPOST_FRA_NAVN": "NTNUI Ålesund Materialansvarlig",
    "VARSEL_TIL": "material@ntnui-alesund.no",
    "SHOP_ADMIN_URL": "https://ntnuiaa-material.github.io/shop/admin/"
  }
}
