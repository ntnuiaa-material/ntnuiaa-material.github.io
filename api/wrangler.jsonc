{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lager-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "observability": { "enabled": true },

  // Database med ting, utlån og hendelser
  "d1_databases": [
    { "binding": "DB", "database_name": "lager", "database_id": "9b3e8333-fb62-4e7d-9d0a-bd9345875dbf" }
  ],

  // Bilder av tingene, krympet til 800 px i nettleseren før opplasting
  "kv_namespaces": [
    { "binding": "BILDER", "id": "8c98ed2bdf2a4caca707abcbaabbd3ad" }
  ],

  // Anonymiserer gamle utlån (12 mnd) og shop-bestillinger (6 mnd), kl. 03 den 1. hver måned
  "triggers": { "crons": ["0 3 1 * *"] },

  // E-post fra shopen via Resend. API-nøkkelen er secret: wrangler secret put RESEND_API_KEY
  "vars": {
    "TILLATTE_ADRESSER": "https://ntnuiaa-material.github.io,http://localhost:8787",
    // Midlertidig: Resend sin testadresse, til DNS for ntnui-alesund.no er lagt inn hos Domeneshop.
    // Testadressen kan bare sende til e-posten Resend-kontoen er registrert med (material@), så
    // kvitteringen til kunden er slått av. Når domenet er verifisert: EPOST_FRA = "NTNUI Ålesund <material-shop@ntnui-alesund.no>" og KVITTERING = "pa".
    "EPOST_FRA": "NTNUI Ålesund <onboarding@resend.dev>",
    "KVITTERING": "av",
    "VARSEL_TIL": "material@ntnui-alesund.no",
    "SHOP_ADMIN_URL": "https://ntnuiaa-material.github.io/shop/admin/"
  }
}
